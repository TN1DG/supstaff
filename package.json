{
  "name": "supstaff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "seed:residents": "dotenv -e .env.local -- tsx scripts/seed-residents.ts",
    "seed:handovers": "dotenv -e .env.local -- tsx scripts/seed-handovers.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
